#!/usr/bin/python


def generatedesktop(filename, appname, _exec, icon, cat):
    path = f"{filename}.desktop"
    with open(path, "x") as file:
        file.write("[Desktop Entry]\n")
        file.write(f"Name={appname}\n")
        file.write(f"Exec={_exec}\n")
        file.write("Type=Application\n")
        file.write(f"Icon={icon}\n")
        file.write(f"Categories={cat}\n")


def main():
    fn = input("desktop file name(without .desktop): ")
    an = input("app name: ")
    e = input("execute command: ")
    c = input("categories: ")
    i = input("icon(path or name): ")
    generatedesktop(fn, an, e, i, c)


main()
